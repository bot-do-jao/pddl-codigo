(define (problem p-1-2-2)
        (:domain barman_htn)
        (:objects
                left right - hand
                shaker1 shaker2 - shaker
                shot1 shot2 shot3 shot4 - shot
                ingredient1 ingredient2 ingredient3 ingredient4 - ingredient
                dispenser1 dispenser2 dispenser3 dispenser4 - dispenser
                cocktail1 cocktail2 - cocktail
                level1 level2 level3 - level
        )
        (:htn
                :parameters ()
                :subtasks
                (and
                        (AchieveContainsShotCocktail shot2 cocktail1)
                        (AchieveContainsShotCocktail shot4 cocktail2)
                )
        )
        (:init
                (ontable shaker1)
                (ontable shot1)
                (ontable shot2)
                (clean shaker1)
                (clean shot1)
                (clean shot2)
                (empty shaker1)
                (empty shot1)
                (empty shot2)
                (dispenses dispenser1 ingredient1)
                (dispenses dispenser2 ingredient2)
                (handEmpty left)
                (handEmpty right)
                (shakerEmptyLevel shaker1 level1)
                (shakerLevel shaker1 level1)
                (next level1 level1)
                (next level2 level2)
                (cocktailPart1 cocktail1 ingredient2)
                (cocktailPart2 cocktail1 ingredient1)
                (ontable shaker2)
                (ontable shot3)
                (ontable shot4)
                (clean shaker2)
                (clean shot3)
                (clean shot4)
                (empty shaker2)
                (empty shot3)
                (empty shot4)
                (dispenses dispenser3 ingredient3)
                (dispenses dispenser4 ingredient4)
                (shakerEmptyLevel shaker2 level1)
                (shakerLevel shaker2 level1)
                (next level1 level1)
                (next level2 level2)
                (cocktailPart1 cocktail2 ingredient3)
                (cocktailPart2 cocktail2 ingredient4)
        )
)
